[Unit]
Description=ABPIV n8n and PostgreSQL Docker stack
After=docker.service network-online.target srv-n8n.mount
Requires=docker.service
RequiresMountsFor=/srv/n8n
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/opt/abpiv-n8n/scripts/assert-data-disk.sh
ExecStartPre=/usr/local/sbin/abpiv-container-firewall --check
ExecStart=/opt/abpiv-n8n/scripts/start-on-boot.sh
ExecStop=/opt/abpiv-n8n/scripts/stop-for-shutdown.sh
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
